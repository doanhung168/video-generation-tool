# Database & Storage
DATABASE_URL=sqlite+aiosqlite:///./video_gen.db
STORAGE_PATH=../storage

# AI Video & Script Generation Models
GOOGLE_API_KEY=your_google_ai_studio_api_key_here    # Google Veo 3, Google Flow, Gemini 2.5/2.0
KIMI_API_KEY=your_kimi_moonshot_api_key_here          # Moonshot AI (Kimi) for scripts & agents
WAN_API_KEY=your_alibaba_wan_api_key_here             # Alibaba Wan 2.1 (DashScope) Video Gen
SEEDANCE_API_KEY=your_bytedance_seedance_api_key_here # ByteDance Doubao / Seedance Video Gen
KLING_API_KEY=your_kling_ai_api_key_here              # Kling AI Video Gen
MINIMAX_API_KEY=your_minimax_api_key_here             # MiniMax Hailuo AI Video Gen
OPENAI_API_KEY=your_openai_api_key_here               # OpenAI Sora / GPT-4o fallback

# Social Media Platforms Auto-Publishing
# Facebook Graph API
FACEBOOK_ACCESS_TOKEN=your_facebook_page_access_token_here
FACEBOOK_PAGE_ID=your_facebook_page_id_here

# TikTok Content Posting API
TIKTOK_ACCESS_TOKEN=your_tiktok_access_token_here

# YouTube Data API v3
YOUTUBE_API_KEY=your_youtube_api_key_here
YOUTUBE_CLIENT_ID=your_youtube_client_id_here
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret_here
YOUTUBE_REFRESH_TOKEN=your_youtube_refresh_token_here
